{
  "datasets": [
    {
      "name": "vendas",
      "displayName": "Vendas diárias",
      "queryLines": [
        "SELECT data_venda, nome_filial, canal, categoria, tipo_produto, quantidade_itens, faturamento, valor_desconto, custo_total, margem_bruta\n",
        "FROM agg_vendas_diarias\n"
      ]
    },
    {
      "name": "pagamentos",
      "displayName": "Pagamentos diários",
      "queryLines": [
        "SELECT data_venda, nome_filial, canal, forma_pagamento, quantidade_pagamentos, valor_pago\n",
        "FROM agg_pagamentos_diarios\n"
      ]
    },
    {
      "name": "cupons",
      "displayName": "Cupons diários",
      "queryLines": [
        "SELECT data_venda, nome_filial, canal, quantidade_vendas, quantidade_clientes_identificados, faturamento\n",
        "FROM agg_vendas_cupons_diarios\n"
      ]
    },
    {
      "name": "produtos",
      "displayName": "Vendas por produto",
      "queryLines": [
        "SELECT v.data_venda, f.nome_filial, v.canal, p.nome_produto, p.laboratorio, p.categoria,\n",
        "  SUM(v.quantidade) AS quantidade, SUM(v.faturamento) AS faturamento, SUM(v.margem_bruta) AS margem_bruta\n",
        "FROM fato_vendas AS v\n",
        "JOIN dim_filial AS f ON f.id_filial = v.id_filial\n",
        "JOIN dim_produto AS p ON p.id_produto = v.id_produto\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "estoque",
      "displayName": "Estoque atual",
      "queryLines": [
        "SELECT f.nome_filial, e.situacao_validade, e.quantidade_disponivel, e.valor_estoque\n",
        "FROM fato_estoque AS e\n",
        "JOIN dim_filial AS f ON f.id_filial = e.id_filial\n",
        "WHERE e.posicao_atual\n"
      ]
    },
    {
      "name": "lotes_criticos",
      "displayName": "Lotes vencidos ou a vencer",
      "queryLines": [
        "SELECT f.nome_filial, p.nome_produto, e.lote, e.data_validade, e.dias_para_vencer, e.quantidade_disponivel, e.valor_estoque\n",
        "FROM fato_estoque AS e\n",
        "JOIN dim_filial AS f ON f.id_filial = e.id_filial\n",
        "JOIN dim_produto AS p ON p.id_produto = e.id_produto\n",
        "WHERE e.posicao_atual AND e.dias_para_vencer <= 60 AND e.quantidade_disponivel > 0\n",
        "ORDER BY e.dias_para_vencer\n"
      ]
    }
  ],
